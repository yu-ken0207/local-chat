{
  "expo": {
    "name": "Local AI",
    "slug": "local-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "在區網裡尋找 Ollama 主機"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "拍照後傳給模型看",
          "photosPermission": "從相簿選照片傳給模型看"
        }
      ],
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "讓 AI 幫你看行事曆、加行程（每次加之前都會先問你）",
          "remindersPermission": "讓 AI 幫你加提醒事項（每次加之前都會先問你）"
        }
      ]
    ]
  }
}
